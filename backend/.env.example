# Copy this file to backend/.env and fill in the values.
# Never commit backend/.env — it holds your database password.

# The simplest option: copy DATABASE_URL from Render → your backend service →
# Environment. Or build it from Supabase → Connect → connection string.
# If the password has special characters (@ # / ?), URL-encode them.
#
# WARNING: the local app reads AND WRITES whatever database this points to.
# Use a staging/copy database if you have one. If you point it at production,
# anything you save locally (assignments, reporting, setup imports) is real.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres"

# Must be the same value as on Render if you want tokens to work across both;
# otherwise any long random string is fine for local use. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# The backend runs on 3001 locally so the frontend can use 3000.
PORT=3001

NODE_ENV=development

# Extra allowed frontend URLs, comma-separated. localhost on any port is
# already allowed in development.
CORS_ORIGINS=http://localhost:3000

# Log any request slower than this many milliseconds as [slow].
SLOW_REQUEST_MS=800

# --- Mock login (local only) -------------------------------------------
# true = any username and password logs in. The backend refuses to start
# with this on a deployed server (NODE_ENV=production or Render).
AUTH_MOCK=false
# admin | manager | viewer | client
AUTH_MOCK_ROLE=admin
# Needed only when AUTH_MOCK_ROLE=client, e.g. park_heights or indradhanush
AUTH_MOCK_PROJECT_ID=
