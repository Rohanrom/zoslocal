generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["views", "partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["indr", "public"]
}

