model billing_tracker_indr {
  id             String    @id
  Application    String?
  Flat           String?
  Surface_Type   String?   @map("Surface Type")
  Layer_Name     String?   @map("Layer Name")
  Billed         Boolean?
  Billing_Number String?   @map("Billing Number")
  Billing_Date   DateTime? @map("Billing Date") @db.Date
  Rate           Decimal?  @db.Decimal(12, 2)
  Billing_Area   Decimal?  @map("Billing Area") @db.Decimal(14, 2)
  Status         String?
  Batch_no_      Int?      @map("Batch no.")
  WorkDonePct    Decimal?  @db.Decimal(7, 2)
  Is_Complete    Boolean?  @map("Is Complete")
  Can_Billed     Boolean?  @map("Can Billed")
  Batch          String?

  @@index([Batch], map: "idx_billing_tracker_indr_batch")
  @@index([Batch_no_], map: "idx_billing_tracker_indr_batch_no")
  @@index([Billed, Is_Complete, Can_Billed], map: "idx_billing_tracker_indr_billed_complete")
  @@index([Flat, Layer_Name, Surface_Type], map: "idx_billing_tracker_indr_flat_layer_surface")
  @@index([Status], map: "idx_billing_tracker_indr_status")
  @@schema("indr")
}

