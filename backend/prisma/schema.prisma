/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invoice_table {
  Sl_No                   Decimal  @id @map("Sl No") @db.Decimal
  Description_of_the_work String   @map("Description of the work")
  Layer_Name              String   @map("Layer Name")
  Surface                 String
  Unit                    String   @default("Sq m")
  Rate                    Decimal  @default(0) @db.Decimal
  Quantity_Previous       Decimal? @default(0) @map("Quantity Previous") @db.Decimal
  Quantity_Current        Decimal? @default(0) @map("Quantity Current") @db.Decimal
  Quantity_Cumulative     Decimal? @default(0) @map("Quantity Cumulative") @db.Decimal
  Amount_Previous         Decimal? @default(0) @map("Amount Previous") @db.Decimal
  Amount_Current          Decimal? @default(0) @map("Amount Current") @db.Decimal
  Amount_Cumulative       Decimal? @default(0) @map("Amount Cumulative") @db.Decimal

  @@unique([Layer_Name, Surface], map: "invoice_table_layer_surface_unique")
  @@schema("indr")
}

model all_site_painter_master {
  painter_id           String                 @id
  row_id               String?
  painter_name         String
  current_site         String?
  category             String?
  daily_wage           Decimal?               @default(0) @db.Decimal
  status               String?                @default("Active")
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  painter_availability painter_availability[]

  @@schema("indr")
}

model assignment_change_log {
  change_id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id                 String?                 @db.Uuid
  recommendation_id      String?                 @db.Uuid
  assignment_id          String?                 @db.Uuid
  field_changed          String?
  old_value              String?
  new_value              String?
  reason                 String?
  changed_by             String?
  changed_at             DateTime?               @default(now()) @db.Timestamptz(6)
  approval_required      Boolean?                @default(false)
  final_assignment       final_assignment?       @relation(fields: [assignment_id], references: [assignment_id], onUpdate: NoAction)
  recommended_assignment recommended_assignment? @relation(fields: [recommendation_id], references: [recommendation_id], onUpdate: NoAction)
  assignment_run         assignment_run?         @relation(fields: [run_id], references: [run_id], onUpdate: NoAction)

  @@schema("indr")
}

model assignment_outcome {
  outcome_id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignment_id        String           @unique(map: "assignment_outcome_assignment_unique") @db.Uuid
  assignment_date      DateTime?        @db.Date
  assigned_area        Decimal?         @default(0) @db.Decimal
  actual_area_done     Decimal?         @default(0) @db.Decimal
  actual_hours         Decimal?         @default(0) @db.Decimal
  completion_percent   Decimal?         @default(0) @db.Decimal
  variance_area        Decimal?         @default(0) @db.Decimal
  outcome_status       String?
  reason_for_shortfall String?
  calculated_at        DateTime?        @default(now()) @db.Timestamptz(6)
  final_assignment     final_assignment @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("indr")
}

model assignment_run {
  run_id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site                    String                   @default("Indradhanush")
  assignment_date         DateTime                 @db.Date
  generated_at            DateTime                 @default(now()) @db.Timestamptz(6)
  generated_by            String?
  status                  String                   @default("Draft")
  total_available_hours   Decimal?                 @default(0) @db.Decimal
  total_demand_hours      Decimal?                 @default(0) @db.Decimal
  total_recommended_hours Decimal?                 @default(0) @db.Decimal
  idle_hours              Decimal?                 @default(0) @db.Decimal
  over_assigned_hours     Decimal?                 @default(0) @db.Decimal
  notes                   String?
  assignment_change_log   assignment_change_log[]
  final_assignment        final_assignment[]
  recommended_assignment  recommended_assignment[]
  work_demand_item        work_demand_item[]

  @@index([assignment_date], map: "idx_assignment_run_date")
  @@schema("indr")
}

model backend {
  id                 String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  block              String?
  application        String?
  flat               String?
  work_layer         String?
  work_date          DateTime?         @db.Date
  wall_names         String?
  area               Decimal?          @default(0) @db.Decimal
  painter_names      String?
  machine_or_manual  String?
  working_hours      Decimal?          @default(0) @db.Decimal
  work_status        String?
  material_name      String?
  material_used_l_kg Decimal?          @default(0) @db.Decimal
  remark             String?
  created_at         DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?         @default(now()) @db.Timestamptz(6)
  layer_id           String?
  assignment_id      String?           @db.Uuid
  final_assignment   final_assignment? @relation(fields: [assignment_id], references: [assignment_id], onUpdate: NoAction)

  @@index([assignment_id], map: "idx_backend_assignment_id")
  @@index([assignment_id, layer_id, work_date], map: "idx_backend_assignment_layer_date")
  @@index([application, flat, work_layer, work_date], map: "idx_backend_main")
  @@index([work_status], map: "idx_backend_status")
  @@schema("indr")
}

model final_assignment {
  assignment_id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id                 String?                 @db.Uuid
  recommendation_id      String?                 @db.Uuid
  assignment_date        DateTime                @db.Date
  block                  String?
  application            String?
  flat                   String?
  layer_name             String?
  surface_type           String?
  assigned_area          Decimal?                @default(0) @db.Decimal
  expected_hours         Decimal?                @default(0) @db.Decimal
  machine_or_manual      String?
  painter_count          Int?                    @default(0)
  assigned_painter_ids   String[]
  assigned_painter_names String[]
  status                 String?                 @default("Published")
  published_at           DateTime?               @default(now()) @db.Timestamptz(6)
  published_by           String?
  created_at             DateTime?               @default(now()) @db.Timestamptz(6)
  layer_id               String?
  assignment_change_log  assignment_change_log[]
  assignment_outcome     assignment_outcome?
  backend                backend[]
  recommended_assignment recommended_assignment? @relation(fields: [recommendation_id], references: [recommendation_id], onUpdate: NoAction)
  assignment_run         assignment_run?         @relation(fields: [run_id], references: [run_id], onUpdate: NoAction)
  final_assignment_wall  final_assignment_wall[]

  @@index([assignment_date], map: "idx_final_assignment_date")
  @@index([application, flat, layer_name], map: "idx_final_assignment_main")
  @@schema("indr")
}

model final_assignment_wall {
  final_assignment_wall_id String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignment_id            String           @db.Uuid
  wall_name                String
  wall_area                Decimal?         @default(0) @db.Decimal
  assigned_area            Decimal?         @default(0) @db.Decimal
  reported_area            Decimal?         @default(0) @db.Decimal
  remaining_area           Decimal?         @default(dbgenerated("GREATEST((COALESCE(assigned_area, (0)::numeric) - COALESCE(reported_area, (0)::numeric)), (0)::numeric)")) @db.Decimal
  wall_status              String?          @default("Assigned")
  final_assignment         final_assignment @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assignment_id, wall_name], map: "final_assignment_wall_unique")
  @@index([assignment_id], map: "idx_final_assignment_wall_assignment")
  @@schema("indr")
}

model indr_qc {
  qc_id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  row_id       String?
  block        String?
  application  String?
  flat         String?
  layer        String?
  layer_id     String?
  layer_order  Decimal?  @db.Decimal
  wall_names   String?
  qc_status    String?
  qc_checklist String?
  qc_date      DateTime? @db.Date
  result       String?
  remark       String?
  qc_by        String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([application, flat, layer, qc_date], map: "idx_qc_main")
  @@schema("indr")
}

model layer {
  layer_id    String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  flat_id     String?
  layer_name  String
  block       String?
  application String?
  flat        String?
  order       Decimal?  @default(999) @db.Decimal
  billable    Boolean   @default(false)
  wkdpct      Decimal   @default(0) @db.Decimal
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([application, flat, layer_name], map: "layer_application_flat_layer_unique")
  @@index([application, flat, layer_name], map: "idx_layer_main")
  @@index([application, flat, order], map: "idx_layer_order")
  @@schema("indr")
}

model painter_availability {
  availability_id         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  availability_date       DateTime                @db.Date
  site                    String                  @default("Indradhanush")
  painter_id              String
  availability_status     String                  @default("Available")
  available_hours         Decimal                 @default(8) @db.Decimal
  reason                  String?
  confirmed_by            String?
  confirmed_at            DateTime?               @default(now()) @db.Timestamptz(6)
  created_at              DateTime?               @default(now()) @db.Timestamptz(6)
  all_site_painter_master all_site_painter_master @relation(fields: [painter_id], references: [painter_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([availability_date, site, painter_id], map: "painter_availability_unique")
  @@schema("indr")
}

model productivity_master {
  productivity_id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  row_id                     String?
  work_layer                 String
  application                String
  machine_or_manual          String?
  ideal_productivity_sqft_hr Decimal?  @default(0) @db.Decimal
  created_at                 DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([application, work_layer, machine_or_manual], map: "productivity_application_layer_mode_unique")
  @@schema("indr")
}

model recommended_assignment {
  recommendation_id              String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id                         String                        @db.Uuid
  demand_id                      String?                       @db.Uuid
  block                          String?
  application                    String?
  flat                           String?
  layer_name                     String?
  surface_type                   String?
  assigned_area                  Decimal?                      @default(0) @db.Decimal
  required_hours                 Decimal?                      @default(0) @db.Decimal
  assignment_type                String?                       @default("Full")
  recommendation_reason          String?
  warning_status                 String?
  machine_or_manual              String?
  painter_count                  Int?                          @default(0)
  assigned_painter_ids           String[]
  assigned_painter_names         String[]
  recommendation_status          String?                       @default("Draft")
  is_manual_edit                 Boolean?                      @default(false)
  override_reason                String?
  created_by                     String?
  created_at                     DateTime?                     @default(now()) @db.Timestamptz(6)
  edited_by                      String?
  edited_at                      DateTime?                     @db.Timestamptz(6)
  layer_id                       String?
  selected_productivity_per_hour Decimal?                      @default(0) @db.Decimal
  productivity_mode_rule         String?
  assignment_change_log          assignment_change_log[]
  final_assignment               final_assignment[]
  work_demand_item               work_demand_item?             @relation(fields: [demand_id], references: [demand_id], onUpdate: NoAction)
  assignment_run                 assignment_run                @relation(fields: [run_id], references: [run_id], onDelete: Cascade, onUpdate: NoAction)
  recommended_assignment_wall    recommended_assignment_wall[]

  @@unique([run_id, demand_id], map: "uq_recommended_assignment_one_active_per_demand", where: raw("((demand_id IS NOT NULL) AND (upper(COALESCE(recommendation_status, ''::text)) <> ALL (ARRAY['REMOVED'::text, 'CANCELLED'::text])))"))
  @@index([run_id], map: "idx_recommended_assignment_run")
  @@schema("indr")
}

model recommended_assignment_wall {
  recommendation_wall_id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recommendation_id               String                 @db.Uuid
  demand_wall_id                  String?                @db.Uuid
  wall_name                       String
  wall_area                       Decimal?               @default(0) @db.Decimal
  assigned_area                   Decimal?               @default(0) @db.Decimal
  remaining_area_after_assignment Decimal?               @default(0) @db.Decimal
  wall_assignment_status          String?                @default("Selected")
  created_at                      DateTime?              @default(now()) @db.Timestamptz(6)
  work_demand_wall                work_demand_wall?      @relation(fields: [demand_wall_id], references: [demand_wall_id], onUpdate: NoAction)
  recommended_assignment          recommended_assignment @relation(fields: [recommendation_id], references: [recommendation_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([recommendation_id, wall_name], map: "recommended_assignment_wall_unique")
  @@schema("indr")
}

model surface_number {
  surface_id     String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  row_id         String?
  block          String?
  application    String?
  base           String?
  wall           String?
  surface_type   String?
  total_area_sft Decimal?  @default(0) @db.Decimal
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([application, base, wall], map: "surface_number_application_base_wall_unique")
  @@index([application, base, wall], map: "idx_surface_number_main")
  @@schema("indr")
}

model work_demand_item {
  demand_id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id                 String                   @db.Uuid
  section                String
  priority_rank          Int
  source_table           String?
  source_id              String?
  block                  String?
  application            String?
  flat                   String?
  layer_name             String?
  surface_type           String?
  layer_order            Decimal?                 @db.Decimal
  billable               Boolean?                 @default(false)
  wall_count             Int?                     @default(0)
  wall_names             String?
  remaining_area         Decimal?                 @default(0) @db.Decimal
  productivity_per_hour  Decimal?                 @default(0) @db.Decimal
  required_hours         Decimal?                 @default(0) @db.Decimal
  oldest_date            DateTime?                @db.Date
  eligibility_status     String?                  @default("Available")
  risk_reason            String?
  demand_status          String?                  @default("Available")
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  layer_id               String?
  machine_or_manual      String?
  productivity_mode_rule String?
  recommended_assignment recommended_assignment[]
  assignment_run         assignment_run           @relation(fields: [run_id], references: [run_id], onDelete: Cascade, onUpdate: NoAction)
  work_demand_wall       work_demand_wall[]

  @@index([application, flat, layer_name, section], map: "idx_work_demand_item_main")
